{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "permission": {
    "edit": {
      "*": "deny",
      "web/**": "allow",
      "web/data/**": "deny",
      "specs/**": "allow",
      "tests/**": "allow",
      "docs/backlog.md": "allow",
      "verifica/**": "allow",
      "AGENTS.md": "allow"
    },
    "webfetch": "deny",
    "bash": {
      "*": "ask",
      "agent-browser*": "allow",
      "git add*": "deny",
      "git commit*": "deny",
      "git push*": "deny",
      "git reset*": "deny",
      "git checkout*": "deny",
      "rm *": "deny",
      "node --check web/*": "allow",
      "git status": "allow",
      "git status --short": "allow",
      "git diff": "allow",
      "git diff --stat": "allow",
      "git log --oneline*": "ask",
      "npm test": "ask"
    }
  }
}
